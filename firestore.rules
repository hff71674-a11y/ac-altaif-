rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Service Booking Requests collection
    match /bookings/{bookingId} {
      // Anyone can submit a booking request for air conditioner services
      allow create: if request.resource.data.keys().hasAll(['fullName', 'phone', 'serviceType', 'neighborhood', 'createdAt'])
                    && request.resource.data.fullName is string
                    && request.resource.data.phone is string;
      // Allow reading bookings
      allow read: if true;
      allow update, delete: if false;
    }

    // Customer Reviews collection
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasAll(['author', 'neighborhood', 'rating', 'comment', 'createdAt'])
                    && request.resource.data.rating >= 1 
                    && request.resource.data.rating <= 5;
      allow update, delete: if false;
    }

    // Contact messages collection
    match /contact_messages/{messageId} {
      allow create: if request.resource.data.keys().hasAll(['name', 'phone', 'message', 'createdAt']);
      allow read: if true;
      allow update, delete: if false;
    }
  }
}
